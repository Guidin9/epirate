{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "key": "",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.primevideo.com/*",
    "https://v3.sg.media-imdb.com/*",
    "https://*.graphql.imdb.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.primevideo.com/*"
      ],
      "js": [
        "shared/episode-formats.js",
        "shared/parse.js",
        "shared/strings.js",
        "shared/settings.js",
        "content/overlay.js",
        "content/primevideo.js",
        "content/primevideo-list.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-badge": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "__MSG_cmdToggle__"
    }
  }
}
